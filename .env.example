# Ascend — contract deployment (Paseo Asset Hub, TESTNET ONLY).
#
# Copy to .env and run `npm run contracts:key` to generate a deployer, or paste your own.
# .env is gitignored and written chmod 600. Nothing here is used by the game at runtime —
# the browser never sees a private key; deployed addresses live in src/chain/config.ts.

# Generated by `npm run contracts:key`. Fund the address before deploying:
#   https://faucet.polkadot.io/paseo?parachain=1000
DEPLOYER_PRIVATE_KEY=
DEPLOYER_ADDRESS=

# Written by `npm run contracts:deploy`.
RUNS_ADDRESS=
RELICS_ADDRESS=
INVITES_ADDRESS=

# Optional: override the Ethereum JSON-RPC endpoint used for deployment.
# ASCEND_RPC=https://paseo-assethub-rpc.laissez-faire.trade
